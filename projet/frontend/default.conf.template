# Sert le SPA ET relaie /api vers le gateway. Même origine => pas de CORS en nominal.
# L'image nginx officielle applique envsubst sur ce fichier au démarrage :
# seule ${GATEWAY_UPSTREAM} (présente dans l'environnement) est substituée,
# les variables nginx ($uri, $host, ...) sont laissées intactes.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Toutes les routes Angular retombent sur index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # /api -> gateway (nom résolu par variable d'env, jamais d'IP).
    location /api/ {
        proxy_pass http://${GATEWAY_UPSTREAM}/api/;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
