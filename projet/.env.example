# Copier en .env :  cp .env.example .env
# Valeurs de DEV jetables. NE PAS committer de vrai secret.

# ── Postgres ───────────────────────────────────────────────
POSTGRES_DB=social
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

# Mots de passe des rôles applicatifs.
# ⚠ doivent correspondre à ceux de db/00-init.sql (valeurs par défaut ci-dessous).
USERS_DB_PASSWORD=users_pwd
POSTS_DB_PASSWORD=posts_pwd
NOTIFICATIONS_DB_PASSWORD=notifications_pwd

# ── JWT (connu du SEUL service users) ──────────────────────
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
JWT_EXPIRATION=86400

# ── Seed de démo ───────────────────────────────────────────
# Non vide => Liquibase charge le contexte "demo" (données de démo).
# Laisser vide pour une base sans données (cible k8s).
SEED_ENABLED=1

# ── Couplage inter-services (résolu PAR NOM, jamais d'IP) ──
USERS_SERVICE_URL=http://users:8080
USERS_HTTP_TIMEOUT_MS=1000
REDIS_HOST=redis
REDIS_PORT=6379

# ── Gateway ────────────────────────────────────────────────
USERS_UPSTREAM=users:8080
POSTS_UPSTREAM=posts:8080
NOTIFICATIONS_UPSTREAM=notifications:8080
CORS_ALLOW_ORIGIN=*

# ── Frontend (voir plan 5) ─────────────────────────────────
GATEWAY_UPSTREAM=gateway:80
