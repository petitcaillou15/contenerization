# Modèle du fichier k8s/.env.secrets : cp k8s/.env.example k8s/.env.secrets, puis remplacer chaque "a_remplir".
# Ce fichier est lu par Kubernetes (Secret app-secrets) ET par la base de données (docker-compose).
# Mots de passe des 3 services pour se connecter à la base
USERS_DB_PASSWORD=a_remplir
POSTS_DB_PASSWORD=a_remplir
NOTIFICATIONS_DB_PASSWORD=a_remplir
# Clé de signature des jetons de connexion
JWT_SECRET=a_remplir